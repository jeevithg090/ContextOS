# Local development settings for the ContextOS server. Copy to backend/.env (read from the directory
# the server is started in) or export the variables. Every setting is a CONTEXTOS_* environment variable
# (app/core/config.py); the values below are the built-in defaults unless marked otherwise.

# development | test | production
CONTEXTOS_ENV=development
# SQLite for development; PostgreSQL in production, e.g.
#   postgresql+psycopg://contextos:<password>@127.0.0.1:5432/contextos
# Create or upgrade the schema with `.venv/bin/python -m app.cli init-db` (or `make migrate`).
CONTEXTOS_DATABASE_URL=sqlite:///./data/contextos.db
# The development default is rejected in production. Use >= 32 random characters (`openssl rand -hex 32`).
CONTEXTOS_SECRET_KEY=contextos-dev-insecure-secret-change-me

CONTEXTOS_SESSION_TTL_HOURS=12
CONTEXTOS_SESSION_COOKIE_NAME=contextos_session
CONTEXTOS_COOKIE_SECURE=false
# JSON list; the Vite dev server (npm run dev) runs on port 5173.
CONTEXTOS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

CONTEXTOS_LOG_LEVEL=INFO
CONTEXTOS_LOG_JSON=false

CONTEXTOS_PREVIEW_CHARS=600
CONTEXTOS_MAX_EVENT_BYTES=512000
CONTEXTOS_MAX_CONTENT_CHARS=200000

# Default retention for new organisations; `contextos-server purge` deletes older event data.
CONTEXTOS_RETENTION_DAYS=90
CONTEXTOS_APPROVAL_DEFAULT_TIMEOUT_S=600

# Repository the Engineering Workspace context-pack builder may read (server-side only; never taken
# from a request). The older name CONTEXTOS_WORKSPACE_ROOT is still accepted.
# CONTEXTOS_WORKSPACE_REPO_ROOT=/path/to/your/repository

# Serve frontend/dist from the API process when it exists (`npm run build` in frontend/).
CONTEXTOS_SERVE_FRONTEND=true
# CONTEXTOS_FRONTEND_DIST=/absolute/path/to/frontend/dist

# Tests only: run the backend suite against a dedicated PostgreSQL test database (its name must contain
# "test"; every table in it is dropped and truncated). Default: a fresh SQLite file per test.
# CONTEXTOS_TEST_DATABASE_URL=postgresql+psycopg://contextos:<password>@127.0.0.1:5432/contextos_test
