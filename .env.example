# ContextOS server configuration for docker-compose.yml. Copy to `.env` and fill in the values marked
# REQUIRED. Every server setting is a CONTEXTOS_* environment variable (app/core/config.py); the
# defaults shown are the built-in ones. Never commit the real `.env`.
#
# Integration-side variables (CONTEXTOS_URL, CONTEXTOS_API_KEY, CONTEXTOS_FAIL_MODE, ...) belong on the
# machine running the agent, not here — see docs/integrations/.

# ----------------------------------------------------------------------------- PostgreSQL (compose)
POSTGRES_DB=contextos
POSTGRES_USER=contextos
# REQUIRED. URL-safe (it is embedded in CONTEXTOS_DATABASE_URL), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
# Host port for the web UI and API (bound to 127.0.0.1).
CONTEXTOS_PORT=8080

# ----------------------------------------------------------------------------- core
# development | test | production. Production refuses to start with the development secret, a secret
# shorter than 32 characters, or CONTEXTOS_COOKIE_SECURE=false.
CONTEXTOS_ENV=production
# docker-compose.yml sets this from the POSTGRES_* values; set it yourself when not using compose.
# CONTEXTOS_DATABASE_URL=postgresql+psycopg://contextos:<password>@db:5432/contextos
# REQUIRED. >= 32 random characters, e.g. `openssl rand -hex 32`. Keys the secret fingerprints, context
# receipt signatures and the audit hash chain: rotating it invalidates existing fingerprints, receipts
# and chain verification.
CONTEXTOS_SECRET_KEY=replace-with-the-output-of-openssl-rand-hex-32

# ----------------------------------------------------------------------------- browser sessions
CONTEXTOS_SESSION_TTL_HOURS=12
CONTEXTOS_SESSION_COOKIE_NAME=contextos_session
# true = the session cookie is only sent over HTTPS (required in production).
CONTEXTOS_COOKIE_SECURE=true
# JSON list of origins allowed to call the API from a browser. Not needed when the UI is served by the
# API itself (same origin); add your public URL when the UI is hosted elsewhere.
CONTEXTOS_CORS_ORIGINS=["https://contextos.example.com"]

# ----------------------------------------------------------------------------- logging
CONTEXTOS_LOG_LEVEL=INFO
CONTEXTOS_LOG_JSON=true

# ----------------------------------------------------------------------------- content inspection
# Raw context content is never stored; only a redacted, truncated preview and a SHA-256 hash.
CONTEXTOS_PREVIEW_CHARS=600
CONTEXTOS_MAX_EVENT_BYTES=512000
CONTEXTOS_MAX_CONTENT_CHARS=200000

# ----------------------------------------------------------------------------- data lifecycle
# Default retention for new organisations (each organisation can change it in Settings -> Privacy).
# Data is deleted by `contextos-server purge`; schedule it daily, e.g.
#   docker compose exec app contextos-server purge
CONTEXTOS_RETENTION_DAYS=90
# Seconds an approval request waits before it expires.
CONTEXTOS_APPROVAL_DEFAULT_TIMEOUT_S=600

# ----------------------------------------------------------------------------- engineering workspace
# Repository working copy the context-pack builder may read (inside the container). Unset = packs hold
# only ContextOS records and say that repository files could not be verified.
# CONTEXTOS_WORKSPACE_REPO_ROOT=/srv/repo

# ----------------------------------------------------------------------------- web UI
# Serve the built SPA from the API process (the image ships it at /app/frontend/dist).
CONTEXTOS_SERVE_FRONTEND=true
CONTEXTOS_FRONTEND_DIST=/app/frontend/dist
